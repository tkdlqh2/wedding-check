# DB 통합 테스트 전용 연결 문자열 — 개발 DB(wedding_check)와 반드시 분리된 별도 DB를 가리켜야 한다.
# 로컬 준비: docker exec wedding-check-db psql -U wedding_check -d wedding_check -c "CREATE DATABASE wedding_check_test OWNER wedding_check;"
# 스키마 적용: npx tsx scripts/apply-migrations.ts "postgresql://wedding_check:wedding_check@localhost:5434/wedding_check_test"
DATABASE_URL="postgresql://wedding_check:wedding_check@localhost:5434/wedding_check_test"
