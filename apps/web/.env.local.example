# Neon Postgres 연결 문자열 (Vercel Marketplace 경유 프로비저닝, AD-10)
DATABASE_URL="postgresql://user:password@ep-example.neon.tech/dbname?sslmode=require"

# better-auth 세션 서명 시크릿 — `openssl rand -hex 32` 등으로 생성
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# lib/ai/adapters/openai.ts에서 사용 — 구조화(FR-9)와 임베딩(FR-6/7) 모두 이 키 하나로
# 동작(2026-07-28 벤더 교체: Anthropic+Voyage → OpenAI, lib/ai/index.ts 조립 지점 참고)
OPENAI_API_KEY=""

# Story 4.1 인사이트 재계산 배치(FR-10, AD-10) — Vercel Cron이 /api/cron/insight-recompute를
# 호출할 때 붙이는 `Authorization: Bearer` 값. Vercel 환경변수에 등록하면 Cron이 자동으로
# 이 헤더를 붙인다. **비워두면 라우트가 503으로 거부한다**(fail closed — 시크릿 없이
# 열린 배치 엔드포인트를 만들지 않는다). 로컬에서 수동 실행할 때도 필요.
CRON_SECRET=""

# Story 1.4 시연 영상 업로드(AD-4, @vercel/blob 클라이언트 업로드) — 비워두면 로컬
# 파일시스템 폴백(.local-blob/)을 자동 사용. Vercel Blob store 생성 후 채우면
# 코드 변경 없이 자동으로 AD-4 경로(클라이언트 사이드 업로드)로 전환됨.
BLOB_READ_WRITE_TOKEN=""

# scripts/seed-accounts.ts 초기 계정 시드용 — 전화번호가 로그인 식별자이므로 4개 모두
# 필수(미지정 시 스크립트가 에러로 중단됨, AD-10 — 알려진 기본 비밀번호 하드코딩 금지)
# 전화번호는 하이픈 없이 숫자만(예: "01012345678") — 넣어도 시드 스크립트가 제거하긴 하지만 기본값은 하이픈 없음
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_PHONE_NUMBER=""
SEED_OPERATOR_PASSWORD=""
SEED_OPERATOR_PHONE_NUMBER=""
